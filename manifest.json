{
  "manifest_version": 3,
  "name": "飞书铁磁",
  "version": "1.0",
  "description": "自动滚动截图飞书文档",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "offscreen"
  ],

  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/*",
        "https://*.larksuite.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
